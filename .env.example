# LinkedInJobTrendAI - Phase 6 LLM configuration
# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# Master switch. Keep "false" to run the whole app without any LLM / API key.
LLM_ENABLED=false

# Your provider API key (OpenAI by default). Never hardcode this in source code.
LLM_API_KEY=your_api_key_here

# Chat model name. gpt-4o-mini is inexpensive and supports JSON mode.
LLM_MODEL=gpt-4o-mini

# Optional: any OpenAI-compatible Chat Completions endpoint.
# Leave as-is for OpenAI; change it to point at another compatible provider.
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Optional: request timeout in seconds.
LLM_TIMEOUT=30
